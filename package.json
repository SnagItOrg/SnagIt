    "test:matcher": "tsx --test scripts/lib/matcher-integrity.test.ts",
    "report-match-backlog": "tsx scripts/report-match-backlog.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "import-kg": "tsx scripts/import-knowledge-graph.ts",
    "export-kg": "tsx scripts/export-knowledge-graph.ts",
    "match-listings:historical-dry-run": "tsx scripts/match-listings.ts --historical-backfill",
    "scrape-reverb": "tsx scripts/scrape-reverb.ts",
    "expand-kg": "tsx scripts/expand-knowledge-graph.ts",
    "scrape-vse": "tsx scripts/scrape-vintagesynth.ts",
    "expand-synonyms": "tsx scripts/expand-synonyms-vse.ts",
    "seed-design-watchlists": "tsx scripts/seed-design-watchlists.ts",
    "scrape-facebook": "tsx scripts/scrape-facebook.ts",
    "fetch-reverb-prices": "tsx scripts/fetch-reverb-prices.ts",
    "fetch-auctionet-prices": "tsx scripts/fetch-auctionet-prices.ts",
    "process-price-queue": "tsx scripts/process-price-queue.ts",
    "build-thomann-urls": "tsx scripts/build-thomann-urls.ts",
    "fetch-thomann-prices": "tsx scripts/fetch-thomann-prices.ts",
    "enrich-products": "tsx scripts/enrich-products.ts",
    "seed-reverb-categories": "tsx scripts/seed-reverb-categories.ts",
    "classify-products": "tsx scripts/classify-products.ts",
    "enrich-from-reverb-csp": "tsx scripts/enrich-from-reverb-csp.ts",
    "backfill-category-uuids": "tsx scripts/backfill-category-uuids.ts",
    "upload-images": "tsx scripts/upload-product-images.ts",
    "upload-csp-images": "tsx scripts/upload-csp-images.ts",
    "flag-dirty-products": "tsx scripts/flag-dirty-products.ts",
    "populate-cleanup-queue": "tsx scripts/populate-cleanup-queue.ts",
    "build-product-artefacts": "tsx scripts/build-product-lifecycle-artefacts.ts",
    "validate-product-artefacts": "tsx scripts/build-product-lifecycle-artefacts.ts --validate",
    "validate-disposition": "tsx scripts/build-candidate-disposition.ts --validate",
    "validate-activation-migration": "tsx scripts/emit-activation-migration.ts --validate",
    "validate-activation": "npm run validate-product-artefacts && npm run validate-disposition && npm run validate-activation-migration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@supabase/supabase-js": "^2.96.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.59.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
